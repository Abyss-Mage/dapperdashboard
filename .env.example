# You do not create this file by hand. Start Dapper (scripts/start.ps1 or sh scripts/start.sh): when there is no completed .env,
# the setup page opens first, asks for these values and writes .env for you. This file only shows what the result looks like.
# The real .env holds secrets: keep it private, never commit it.
DAPPER_INSTALLED="1"
DAPPER_SITE_NAME="Your business name"
DAPPER_SITE_URL="https://dapper.example.com"
DAPPER_TIMEZONE="America/Toronto"
DAPPER_LISTEN="127.0.0.1:8443"
DAPPER_TLS_MODE="proxy"          # self-signed | files | proxy
DAPPER_TLS_CERT=""
DAPPER_TLS_KEY=""
DAPPER_DATABASE_URL="postgres://dapper:PASSWORD@localhost:5432/dapper?sslmode=disable"
DAPPER_SMTP_HOST=""
DAPPER_SMTP_PORT="587"
DAPPER_SMTP_USERNAME=""
DAPPER_SMTP_PASSWORD=""
DAPPER_SMTP_FROM_ADDRESS=""
DAPPER_SMTP_FROM_NAME=""
DAPPER_MFA_KEY="generated by setup"
DAPPER_INVITATION_ENCRYPTION_KEY="generated by setup"
DAPPER_SESSION_LIFETIME="8h"
