# The legacy import MCP server (tools/legacy-import-mcp): Claude Code reaches it at https://<dashboard domain>/legacy-import/mcp with the
# token from /etc/dapper/import-mcp.env. It listens on 127.0.0.1:8765 only; Caddy is the only way in.
[Unit]
Description=Dapper legacy import MCP server
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/dapper/import-mcp.env

[Service]
User=dapper
Group=dapper
WorkingDirectory=/opt/dapper/app
# The app's .env gives it DAPPER_DATABASE_URL (the import target); import-mcp.env holds the token and the WordPress sign-in.
EnvironmentFile=/opt/dapper/app/.env
EnvironmentFile=/etc/dapper/import-mcp.env
Environment=PATH=/usr/local/go/bin:/usr/local/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOPATH=/opt/dapper/go GOCACHE=/opt/dapper/.cache/go HOME=/opt/dapper
ExecStart=/opt/dapper/mcp-venv/bin/python /opt/dapper/app/tools/legacy-import-mcp/server.py --http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
