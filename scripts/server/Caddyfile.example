# Dapper production front door. Copy to /etc/caddy/Caddyfile, replace the e-mail, then: systemctl reload caddy
# Each address gets a real HTTPS certificate automatically once its DNS A record points at this server.
{
	email you@example.com
}

dashboard.dapperdetailing.ca {
	encode zstd gzip
	# The legacy import MCP server (token required; see dapper-import-mcp.service).
	handle /legacy-import/* {
		reverse_proxy 127.0.0.1:8765
	}
	handle {
		reverse_proxy 127.0.0.1:8443
	}
}

workspace.dapperdetailing.ca {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8443
}

# On go-live day, when dapperdetailing.ca moves to this server, add:
# dapperdetailing.ca {
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:8443
# }
# www.dapperdetailing.ca {
# 	redir https://dapperdetailing.ca{uri} permanent
# }
